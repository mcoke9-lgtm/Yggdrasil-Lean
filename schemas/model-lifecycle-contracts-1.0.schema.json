            "properties": {
              "stage": {
                "type": "string",
                "enum": [
                  "provenance",
                  "integrity",
                  "compatibility",
                  "capability",
                  "safety_authority",
                  "resource",
                  "recovery"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "INCOMPLETE",
                  "BLOCKED"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidenceRef"
                }
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "retained_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "lost_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "resource_observations": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          }
        },
        "evaluators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmpty"
          }
        },
        "evaluated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmpty"
          }
        }
      },
      "additionalProperties": false
    }
