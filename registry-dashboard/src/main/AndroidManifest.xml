<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="org.yggdrasil.builderhost" />
        <package android:name="org.yggdrasil.scheduler" />
        <package android:name="org.yggdrasil.keysteward" />
        <package android:name="org.yggdrasil.signingdiagnostic" />
    </queries>
    <application
        android:allowBackup="false"
        android:label="Yggdrasil App Registry"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
